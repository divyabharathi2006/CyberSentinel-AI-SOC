# Copy to .env and replace every placeholder with locally generated values.
FLASK_DEBUG=false
HOST=127.0.0.1
PORT=5000
SECRET_KEY=replace-with-a-unique-random-secret
JWT_SECRET_KEY=replace-with-a-different-unique-random-secret
JWT_ACCESS_TOKEN_MINUTES=30

# Local Docker Compose uses PostgreSQL. For direct local development, omit
# DATABASE_URL to use ./instance/cybersentinel.db (SQLite).
DATABASE_URL=postgresql+psycopg://cybersentinel:replace-this-db-password@localhost:5432/cybersentinel
POSTGRES_DB=cybersentinel
POSTGRES_USER=cybersentinel
POSTGRES_PASSWORD=replace-this-db-password

ELASTICSEARCH_URL=http://localhost:9200
ELASTICSEARCH_USERNAME=
ELASTICSEARCH_PASSWORD=
ELASTICSEARCH_INDEX=cybersentinel-events
THREAT_INTEL_API_KEY=
CORS_ORIGINS=
MAX_CONTENT_LENGTH=1048576
LOG_LEVEL=INFO
ENABLE_SYSLOG=false
SYSLOG_HOST=127.0.0.1
SYSLOG_PORT=1514
ALERT_DEDUP_MINUTES=30
AUTH_FAILURE_THRESHOLD=5
AUTH_WINDOW_MINUTES=10
AUTH_CORRELATION_WINDOW_MINUTES=15
NETWORK_PORT_THRESHOLD=8
NETWORK_WINDOW_MINUTES=10
ML_ANOMALY_ALERT_THRESHOLD=0.85
RISK_LOW_MIN=25
RISK_MEDIUM_MIN=50
RISK_HIGH_MIN=75
RISK_CRITICAL_MIN=90
REPORT_MAX_RECORDS=1000

# Docker Compose configures Kafka automatically. Set a broker here only when
# running the Flask application directly with a separately managed Kafka cluster.
# KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_EVENTS_TOPIC=cybersentinel.events
KAFKA_DEAD_LETTER_TOPIC=cybersentinel.events.dlq
KAFKA_CONSUMER_GROUP=cybersentinel-processors
KAFKA_PUBLISH_TIMEOUT_SECONDS=10
KAFKA_WORKER_HEARTBEAT_SECONDS=15
KAFKA_MAX_HEALTHY_LAG=1000
